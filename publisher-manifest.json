rder-left:0;border-top:1px solid var(--slate-100);padding-left:0;padding-top:16px}\n    .sec-head{grid-template-columns:1fr;gap:10px}\n    .sec-head p{grid-column:1}\n    section{padding:56px 0}\n    .faq-item{grid-template-columns:1fr;gap:6px}\n  }\n</style><header class=\"hero\" id=\"top\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <a class=\"brandline\" href=\"#top\">GZ<span>·</span>高铁复兴号</a>\n      <p>服务方案 · 使用说明 · 常见问题</p>\n    </div>\n\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"kicker\">方案说明</p>\n        <h1>GZ高铁复兴号<em>先把规则写清楚。</em></h1>\n        <p class=\"hero-lead\">这里摆放的是三档服务方案、上线前的准备步骤，以及集中回答的问题。价格、额度、设备数逐条列出，不含糊，不省略。</p>\n        <ul class=\"hero-tags\">\n          <li><a href=\"#plans\">看方案</a></li>\n          <li><a href=\"#guide\">看步骤</a></li>\n          <li><a href=\"#clients\">看客户端</a></li>\n          <li><a href=\"#faq\">看问答</a></li>\n        </ul>\n      </div>\n\n      <aside class=\"panel\">\n        <h2>速览</h2>\n        <p class=\"panel-note\">以下信息与正文方案一致，以正文为准。</p>\n        <dl>\n          <div class=\"row\">\n            <dt>方案档位</dt>\n            <dd>三档</dd>\n          </div>\n          <div class=\"row\">\n            <dt>月付起价</dt>\n            <dd><strong>¥15</strong> / 月</dd>\n          </div>\n          <div class=\"row\">\n            <dt>年付起价</dt>\n            <dd><strong>¥150</strong> / 年</dd>\n          </div>\n          <div class=\"row\">\n            <dt>设备数</dt>\n            <dd>3 / 5 / 20 台</dd>\n          </div>\n          <div class=\"row\">\n            <dt>月度流量</dt>\n            <dd>100 / 300 / 1000 GB</dd>\n          </div>\n          <div class=\"row\">\n            <dt>准备步骤</dt>\n            <dd>4 步</dd>\n          </div>\n          <div class=\"row\">\n            <dt>常见问题</dt>\n            <dd>6 条</dd>\n          </div>\n        </dl>\n        <p class=\"panel-foot\">本页只描述方案与流程，不含开通、付款或下载入口。需要核对具体条款时，请以实际书面说明为准。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01 / 使用说明</span>\n        <h2>四步走完，再谈其他</h2>\n        <p>步骤按顺序做，中间不要跳。每一步只解决一件事，做完再做下一步。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"no\">STEP 01</span>\n          <h3>先定用途</h3>\n          <p>写清楚要用在哪几台设备、每月大致多少流量、是否需要多人共用。用途定下来，档位才有得选。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">STEP 02</span>\n          <h3>按设备数与流量对档</h3>\n          <p>三台以内看基础版，五台左右看旗舰版，二十台或多人协作看团队版。流量额度是月度口径。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">STEP 03</span>\n          <h3>准备客户端环境</h3>\n          <p>把要用的设备系统版本记下来，预留出配置时间。客户端支持范围见下方客户端区块。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"no\">STEP 04</span>\n          <h3>逐台接入并自查</h3>\n          <p>一台一台来，每台接好就测一次，确认正常再处理下一台。异常集中记录，方便一次性说清。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02 / 服务方案</span>\n        <h2>三档方案，逐行展开</h2>\n        <p>从左到右读：档位与价格、包含的权益、适合谁。年付价格按整年计。</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-name\">\n            <h3>基础版</h3>\n            <p class=\"plan-price\"><strong>¥15 / 月</strong>按年付 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>最多 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p><strong>适合谁</strong>个人日常使用，一两台手机加一台电脑，流量需求不大。</p>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-name\">\n            <span class=\"flag\">推荐</span>\n            <h3>旗舰版</h3>\n            <p class=\"plan-price\"><strong>¥35 / 月</strong>按年付 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>最多 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p><strong>适合谁</strong>手机、平板、电脑同时在用，对线路质量与响应速度有要求。</p>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-name\">\n            <h3>团队版</h3>\n            <p class=\"plan-price\"><strong>¥85 / 月</strong>按年付 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>最多 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p><strong>适合谁</strong>小团队共用，设备多、流量大，需要有人对接具体需求。</p>\n          </div>\n        </article>\n      </div>\n\n      <p class=\"fineprint\">价格与权益以本页所列内容为准。年付按整年一次性计算，不按月拆分。流量额度为月度口径，设备数为同时在线上限。以上描述不构成对线路质量、可用性或结果的具体承诺。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03 / 客户端</span>\n        <h2>准备环境，先看这一块</h2>\n        <p>下面只说明各平台的准备方式与当前状态。具体安装文件与下载地址不在本页提供。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <h3>桌面端</h3>\n          <p>常见桌面系统可准备客户端环境。安装前先确认系统版本，安装后按提示完成配置，再逐台自查。</p>\n          <span class=\"status\">安装文件不在本页提供</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端</h3>\n          <p>手机与平板按对应应用商店或官方渠道获取。设备数受方案上限约束，接入前先数清台数。</p>\n          <span class=\"status\">下载地址不在本页提供</span>\n        </article>\n        <article class=\"client\">\n          <h3>路由器与多设备</h3>\n          <p>需要整屋或多设备共用时，先确认路由器型号与固件环境，再决定用哪种接入方式。</p>\n          <span class=\"status\">配置说明待书面确认</span>\n        </article>\n        <article class=\"client\">\n          <h3>团队批量接入</h3>\n          <p>团队版涉及多设备与定制路由，建议先整理设备清单和用途，再统一安排配置顺序。</p>\n          <span class=\"status\">由客户经理对接</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04 / 常见问题</span>\n        <h2>六个问题，逐条回答</h2>\n        <p>问得最多的几件事，答案写在下面。没覆盖到的，按同样口径书面确认。</p>\n      </div>\n\n      <div class=\"faq-list\">\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q1</div>\n          <div>\n            <h3>三档方案的主要区别是什么？</h3>\n            <p>区别在三处：月度流量额度、同时在线设备数、线路与服务层级。基础版 100GB 与 3 台，旗舰版 300GB 与 5 台并含专线游戏优化与优先工单，团队版 1000GB 与 20 台并含 VIP 节点、定制路由与专属客户经理。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q2</div>\n          <div>\n            <h3>年付和月付怎么算？</h3>\n            <p>年付是按整年一次性计算：基础版 ¥150 / 年、旗舰版 ¥350 / 年、团队版 ¥850 / 年。对应月付为 ¥15、¥35、¥85。年付不按月拆分，也不按剩余月份折算。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q3</div>\n          <div>\n            <h3>设备数是怎么算的？</h3>\n            <p>按同时在线台数计。基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限时需要减少在线设备，或改选更高档位。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q4</div>\n          <div>\n            <h3>流量额度用完了会怎样？</h3>\n            <p>额度是月度口径。当月额度用尽后，处理方式以书面条款为准，本页不做额外承诺。需求长期超出时，直接改选更高档位更省事。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q5</div>\n          <div>\n            <h3>客户端从哪里获取？</h3>\n            <p>本页不提供安装文件与下载地址。桌面端、移动端、路由器三类环境的准备方式见客户端区块，具体获取渠道以书面说明为准。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"q-no\">Q6</div>\n          <div>\n            <h3>接入出问题时该怎么反馈？</h3>\n            <p>先把四项写下来：设备类型与系统版本、所在档位、出错时间、具体现象。信息齐了再提交，处理会快一些。旗舰版与团队版有对应的支持通道。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"jumpband\">\n    <div class=\"wrap\">\n      <ul>\n        <li><a href=\"#top\">回到开头</a></li>\n        <li><a href=\"#guide\">使用说明</a></li>\n        <li><a href=\"#plans\">服务方案</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n  </div>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot-grid\">\n    <div>\n      <strong>GZ高铁复兴号</strong>\n      <p>本页为方案与流程说明页。价格、权益、设备数与流量额度以本页列出的内容为准。</p>\n    </div>\n    <div>\n      <p>不含开通、付款与下载入口。需要核对条款时，请以实际书面说明为准。</p>\n      <p><a href=\"#top\">返回顶部</a></p>\n    </div>\n  </div>\n</footer>",
